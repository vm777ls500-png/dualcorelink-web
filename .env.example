# Public frontend origin used by future metadata and schema layers.
NEXT_PUBLIC_SITE_URL=https://dualcorelink.com

# Local WordPress REST root.
WORDPRESS_REST_ROOT=http://127.0.0.1:8080/wp-json
WORDPRESS_MEDIA_ORIGIN=http://127.0.0.1:8080

NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,zh,de,es,ar,vi,fa

# Future build controls.
BUILD_CONTENT_LIMIT=100
BUILD_FETCH_CONCURRENCY=4
