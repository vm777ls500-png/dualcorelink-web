# Prepared in AWS Migration Phase B5. Do not enable before the approved B6 cutover.
server {
    listen 80;
    listen [::]:80;
    server_name dualcorelink.com www.dualcorelink.com;
    root /srv/dualcorelink/frontend/current;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/dualcorelink;
        allow all;
        try_files $uri =404;
    }

    location = /solutions/oem-odm-custom-panel-solution/ {
        if (-f $document_root/en/solutions/oem-odm-custom-panel-solution/index.html) {
            return 301 https://dualcorelink.com/en/solutions/oem-odm-custom-panel-solution/;
        }
        return 404;
    }

    location = /resources/hotel-rcu-wiring-system-architecture-guide/ {
        if (-f $document_root/en/resources/hotel-rcu-wiring-system-architecture-guide/index.html) {
            return 301 https://dualcorelink.com/en/resources/hotel-rcu-wiring-system-architecture-guide/;
        }
        return 404;
    }

    location ~ ^/(?:ar|zh|de|es|vi|fa)/(?:about|contact|faqs|products|solutions|resources|regions|(?:products|solutions|resources|regions)/[a-z0-9-]+)/?$ {
        return 301 https://dualcorelink.com$request_uri;
    }

    location ~ ^/(?:zh|de|es|ar|vi|fa)/?$ {
        return 301 https://dualcorelink.com/en/;
    }

    location ~ ^/(?:zh|de|es|ar|vi|fa)(?<legacy_path>/.*?)/?$ {
        if (-f $document_root/en$legacy_path/index.html) {
            return 301 https://dualcorelink.com/en$legacy_path/;
        }
        return 404;
    }

    location / {
        return 301 https://dualcorelink.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.dualcorelink.com;
    root /srv/dualcorelink/frontend/current;

    ssl_certificate /etc/letsencrypt/live/dualcorelink.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dualcorelink.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /solutions/oem-odm-custom-panel-solution/ {
        if (-f $document_root/en/solutions/oem-odm-custom-panel-solution/index.html) {
            return 301 https://dualcorelink.com/en/solutions/oem-odm-custom-panel-solution/;
        }
        return 404;
    }

    location = /resources/hotel-rcu-wiring-system-architecture-guide/ {
        if (-f $document_root/en/resources/hotel-rcu-wiring-system-architecture-guide/index.html) {
            return 301 https://dualcorelink.com/en/resources/hotel-rcu-wiring-system-architecture-guide/;
        }
        return 404;
    }

    location ~ ^/(?:ar|zh|de|es|vi|fa)/(?:about|contact|faqs|products|solutions|resources|regions|(?:products|solutions|resources|regions)/[a-z0-9-]+)/?$ {
        return 301 https://dualcorelink.com$request_uri;
    }

    location ~ ^/(?:zh|de|es|ar|vi|fa)/?$ {
        return 301 https://dualcorelink.com/en/;
    }

    location ~ ^/(?:zh|de|es|ar|vi|fa)(?<legacy_path>/.*?)/?$ {
        if (-f $document_root/en$legacy_path/index.html) {
            return 301 https://dualcorelink.com/en$legacy_path/;
        }
        return 404;
    }

    location / {
        return 301 https://dualcorelink.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dualcorelink.com;

    root /srv/dualcorelink/frontend/current;
    index index.html;

    access_log /var/log/nginx/dualcorelink-production-access.log;
    error_log /var/log/nginx/dualcorelink-production-error.log;

    ssl_certificate /etc/letsencrypt/live/dualcorelink.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dualcorelink.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    autoindex off;
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    include /etc/nginx/snippets/dualcorelink-inquiry-api.conf;

    location = /solutions/oem-odm-custom-panel-solution/ {
        if (-f $document_root/en/solutions/oem-odm-custom-panel-solution/index.html) {
            return 301 https://dualcorelink.com/en/solutions/oem-odm-custom-panel-solution/;
        }
        return 404;
    }

    location = /resources/hotel-rcu-wiring-system-architecture-guide/ {
        if (-f $document_root/en/resources/hotel-rcu-wiring-system-architecture-guide/index.html) {
            return 301 https://dualcorelink.com/en/resources/hotel-rcu-wiring-system-architecture-guide/;
        }
        return 404;
    }

    # Native-reviewed multilingual release batches: all 69 Chinese and 69 Arabic content URLs.
    location ~ ^/(?<reviewed_locale>zh|ar)/(?<reviewed_path>about|contact|faqs|products|solutions|resources|regions|products/(?:hotel-smart-room-rcu-host-1|rcu-controller-cabinet|86-type-ai-smart-control-display|smart-four-key-scene-control-panel|hotel-smart-room-rcu-host-3|hotel-delivery-robot-charging-dock|hotel-smart-room-rcu-host-2|smart-curtain-motor|smart-four-key-curtain-control-panel|smart-key-card-energy-saver-panel|hotel-guest-room-doorbell|hotel-room-door-magnetic-sensor|embedded-human-presence-sensor|hotel-smart-delivery-cabinet|hotel-delivery-robot|ai-music-control-panel|thermostat-hvac-control-panel|rotary-knob-smart-control-display|ai-large-smart-display|hotel-ceiling-background-speaker|brushed-aluminum-voice-telephone-information-panel|borui-red-matte-triple-socket-panel|smart-series-dual-vertical-socket-panel|smart-footlight-night-light-panel|smart-three-key-music-control-panel|smart-single-key-switch-panel|smart-voice-telephone-information-socket|brushed-aluminum-thermostat-control-panel|brushed-aluminum-sos-alarm-panel|vintage-gold-four-key-smart-switch-panel|vintage-gold-key-card-energy-saver-panel|borui-red-matte-room-status-four-key-switch-panel|borui-red-matte-usb-five-hole-socket|brushed-aluminum-86-base-doorbell-panel|smart-usb-five-hole-socket|infrared-repeater)|solutions/(?:oem-odm-custom-panel-solution|rcu-room-control-solution|smart-hotel-automation-solution|hotel-delivery-robot-solution|ai-smart-display-solution|hotel-guest-room-control-solution)|resources/(?:hotel-rcu-wiring-system-architecture-guide|hotel-smart-switch-panel-guide|oem-odm-smart-panel-customization-guide|hotel-guest-room-automation-guide|hotel-room-control-system-cost-factors|hotel-occupancy-sensor-selection-guide|oem-odm-hotel-control-panel-development-process|hotel-renovation-smart-room-upgrade-guide|knx-vs-rcu-hotel-room-control|hotel-guest-room-control-interfaces-guide|what-is-hotel-rcu-room-control-system|hotel-rcu-buying-guide|smart-hotel-room-control-system-guide|hotel-doorplate-room-display-buying-guide|smart-panel-material-finish-selection-guide)|regions/(?:southeast-asia|vietnam|middle-east|saudi-arabia|uae))/?$ {
        try_files /$reviewed_locale/$reviewed_path/index.html =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Next.js RSC prefetch payloads for the same exact 69 Chinese and 69 Arabic URLs only.
    # Nginx location matching ignores the _rsc query value by design.
    location ~ ^/(?<reviewed_rsc_locale>zh|ar)/(?<reviewed_rsc_path>about|contact|faqs|products|solutions|resources|regions|products/(?:hotel-smart-room-rcu-host-1|rcu-controller-cabinet|86-type-ai-smart-control-display|smart-four-key-scene-control-panel|hotel-smart-room-rcu-host-3|hotel-delivery-robot-charging-dock|hotel-smart-room-rcu-host-2|smart-curtain-motor|smart-four-key-curtain-control-panel|smart-key-card-energy-saver-panel|hotel-guest-room-doorbell|hotel-room-door-magnetic-sensor|embedded-human-presence-sensor|hotel-smart-delivery-cabinet|hotel-delivery-robot|ai-music-control-panel|thermostat-hvac-control-panel|rotary-knob-smart-control-display|ai-large-smart-display|hotel-ceiling-background-speaker|brushed-aluminum-voice-telephone-information-panel|borui-red-matte-triple-socket-panel|smart-series-dual-vertical-socket-panel|smart-footlight-night-light-panel|smart-three-key-music-control-panel|smart-single-key-switch-panel|smart-voice-telephone-information-socket|brushed-aluminum-thermostat-control-panel|brushed-aluminum-sos-alarm-panel|vintage-gold-four-key-smart-switch-panel|vintage-gold-key-card-energy-saver-panel|borui-red-matte-room-status-four-key-switch-panel|borui-red-matte-usb-five-hole-socket|brushed-aluminum-86-base-doorbell-panel|smart-usb-five-hole-socket|infrared-repeater)|solutions/(?:oem-odm-custom-panel-solution|rcu-room-control-solution|smart-hotel-automation-solution|hotel-delivery-robot-solution|ai-smart-display-solution|hotel-guest-room-control-solution)|resources/(?:hotel-rcu-wiring-system-architecture-guide|hotel-smart-switch-panel-guide|oem-odm-smart-panel-customization-guide|hotel-guest-room-automation-guide|hotel-room-control-system-cost-factors|hotel-occupancy-sensor-selection-guide|oem-odm-hotel-control-panel-development-process|hotel-renovation-smart-room-upgrade-guide|knx-vs-rcu-hotel-room-control|hotel-guest-room-control-interfaces-guide|what-is-hotel-rcu-room-control-system|hotel-rcu-buying-guide|smart-hotel-room-control-system-guide|hotel-doorplate-room-display-buying-guide|smart-panel-material-finish-selection-guide)|regions/(?:southeast-asia|vietnam|middle-east|saudi-arabia|uae))/index\.txt$ {
        try_files /$reviewed_rsc_locale/$reviewed_rsc_path/index.txt =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ~ ^/(?:zh|de|es|ar|vi|fa)/?$ {
        return 301 https://dualcorelink.com/en/;
    }

    location ~ ^/(?:zh|de|es|ar|vi|fa)(?<legacy_path>/.*?)/?$ {
        if (-f $document_root/en$legacy_path/index.html) {
            return 301 https://dualcorelink.com/en$legacy_path/;
        }
        return 404;
    }

    location ^~ /_next/static/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(?:avif|gif|ico|jpe?g|png|svg|webp|woff2?|pdf)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        try_files $uri $uri/ $uri/index.html =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
}
