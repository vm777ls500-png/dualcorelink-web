{
  "name": "dualcorelink-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run export:clean && npm run multilingual:export-audit",
    "export:clean": "tsx scripts/clean-static-export.ts",
    "lint": "eslint",
    "test": "npm run test:data",
    "test:data": "tsx --test tests/*.test.ts",
    "media:audit": "tsx scripts/audit-product-media.ts",
    "multilingual:audit": "tsx scripts/audit-multilingual-publication.ts",
    "multilingual:export-audit": "tsx scripts/audit-multilingual-export.ts",
    "multilingual:static-export-audit": "tsx scripts/audit-multilingual-export.ts",
    "multilingual:review-preview": "node scripts/build-multilingual-review-preview.mjs ar",
    "multilingual:release-check": "tsx scripts/check-multilingual-release.ts",
    "multilingual:review-pack": "tsx scripts/generate-multilingual-review-packs.ts",
    "multilingual:apply-native-review": "tsx scripts/apply-native-review.ts",
    "cms-import:test": "tsx scripts/cms-import/run-tests.ts",
    "cms-import:fixture-preflight": "tsx scripts/cms-import/fixture-preflight.ts",
    "cms-import:payload": "tsx scripts/cms-import/generate-payload.ts",
    "cms-import:package": "tsx scripts/cms-import/package-plugin.ts",
    "cms-import:verify-package": "tsx scripts/cms-import/verify-package.ts",
    "cms-import:verify-approved-package": "tsx scripts/cms-import/verify-approved-package.ts",
    "cms-import:reproducibility": "tsx scripts/cms-import/reproducibility.ts",
    "test:inquiry-infra": "node infra/inquiry/scripts/sync-inline-handler.mjs --check && node --test infra/inquiry/test/*.test.mjs",
    "rest:check": "tsx scripts/check-wordpress-rest.ts",
    "pages:build": "npm run build",
    "pages:preview": "npm run pages:build && wrangler pages dev out",
    "pages:deploy": "npm run pages:build && wrangler pages deploy out --project-name dualcorelink-web",
    "wp:up": "docker compose up -d",
    "wp:down": "docker compose down"
  },
  "dependencies": {
    "next": "15.5.19",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "wrangler": "4.112.0"
  }
}
